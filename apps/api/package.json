{
  "name": "@roastcost/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup src/server.ts scripts/migrate.ts scripts/create-admin.ts --format esm --target node22 --clean --no-splitting",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/compress": "^8.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@roastcost/shared": "workspace:*",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.1.0",
    "jose": "^6.1.0",
    "kysely": "^0.28.8",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
