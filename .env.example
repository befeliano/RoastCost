# ---- API (apps/api) ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# API connects as roastcost_app (NOT superuser, NO BYPASSRLS)
DATABASE_URL=postgres://roastcost_app:app_dev@127.0.0.1:5432/roastcost
# Migrations run as the schema owner
MIGRATOR_DATABASE_URL=postgres://roastcost_migrator:migrator_dev@127.0.0.1:5432/roastcost
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public origin used in roaster links (/r/:token) and e-mails
PUBLIC_BASE_URL=http://localhost:3000
# smtps://user:pass@smtp.example.com.tr:465  (empty in dev → e-mails are printed to the log)
SMTP_URL=
MAIL_FROM="RoastCost <no-reply@example.com>"
TRUST_PROXY=false
CONTACT_EMAIL=destek@example.com
DATA_CONTROLLER="[Veri sorumlusu adı / unvanı]"

# ---- docker-compose (local postgres) ----
POSTGRES_SUPERUSER_PASSWORD=postgres
ROASTCOST_MIGRATOR_PASSWORD=migrator_dev
ROASTCOST_APP_PASSWORD=app_dev
